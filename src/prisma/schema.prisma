// =============================================================================
//  Class Management & Teacher Portal — Prisma schema
//  Prisma ORM 7 · PostgreSQL
//
//  - Connection URL lives in /prisma.config.ts (Prisma 7 no longer reads `url` here).
//  - Client is generated into src/generated/prisma (git-ignored, rebuilt on install).
//  - Runtime connects through the `@prisma/adapter-pg` driver adapter
//    (see src/lib/db/prisma.ts).
//
//  ⚠️ ACCESS RULE: Only `src/services/**` (and `src/lib/db/**`) may import the
//     generated client. Enforced by ESLint `no-restricted-imports`.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
//  ENUMS
// -----------------------------------------------------------------------------

enum AnnouncementCategory {
  urgent
  schedule
  tuition
  homework
  event
}

enum ContentStatus {
  published
  draft
  pending_review
}

enum SessionStatus {
  upcoming
  ongoing
  completed
}

enum AttendanceStatus {
  present
  late
  absent
  excused
}

enum HonorPeriod {
  week
  month
  course
}

enum PodcastCategory {
  weekly_digest
  ielts_listening
  pronunciation
  parent_corner
}

enum FileVisibility {
  public
  private
}

enum ResourceFileType {
  PDF
  SLIDE
  AUDIO
  WORKSHEET
  IMAGE
}

enum StorageProviderType {
  cloudinary
  supabase
  r2
  s3
  local
}

enum TuitionStatus {
  paid
  due_soon
  overdue
}

enum StudentStatus {
  active
  trial
  on_leave
  archived
}

enum ClassroomStatus {
  upcoming
  active
  completed
  archived
}

enum ScheduleExceptionType {
  canceled
  rescheduled
  makeup
}

enum JournalStatus {
  completed
  draft
  not_started @map("not-started")
}

enum SessionCompletionResult {
  completed
  partial
  not_completed @map("not-completed")
}

enum HomeworkStatus {
  submitted
  not_submitted @map("not-submitted")
  exempt
  unrecorded
}

enum LearningStatus {
  good
  satisfactory
  needs_support @map("needs-support")
  unrecorded
}

enum GradePublishStatus {
  published
  draft
}

enum AnalyticsAlertAckStatus {
  active
  acknowledged
  resolved
}

enum UserRole {
  admin
  student
}

// -----------------------------------------------------------------------------
//  0. AUTH PROFILES & TWO-ROLE RBAC (SUPABASE AUTH LINKED)
// -----------------------------------------------------------------------------

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  avatarUrl String?  @map("avatar_url")
  role      UserRole @default(student)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  student   Student?

  @@index([role, isActive])
  @@map("profiles")
}

// -----------------------------------------------------------------------------
//  1. TEACHER BRAND & SYSTEM SETTINGS
// -----------------------------------------------------------------------------

model TeacherSetting {
  id                            String   @id @default("default")
  name                          String
  title                         String
  credentials                   String[]
  slogan                        String
  shortBio                      String
  philosophy                    String
  experienceYears               Int      @default(9)
  totalStudents                 Int      @default(420)
  bandAchievementRate           String
  email                         String
  avatarUrl                     String?  @map("avatar_url")
  socialsJson                   Json?    @map("socials_json")
  brandThemeJson                Json?    @map("brand_theme_json")
  officeHours                   String
  location                      String
  currentTerm                   String   @default("Học kỳ I · Năm học 2026–2027")
  defaultPortalPin              String   @default("123456")
  autoNotifyParents             Boolean  @default(true)
  presignedExpirySeconds        Int      @default(900)
  lowAttendanceThresholdPercent Int      @default(90) @map("low_attendance_threshold_percent")
  tuitionReminderDaysBefore     Int      @default(7) @map("tuition_reminder_days_before")
  requirePortalVerification     Boolean  @default(true) @map("require_portal_verification")
  updatedAt                     DateTime @updatedAt
}

model SettingsAuditLog {
  id            String   @id @default(cuid())
  action        String
  actorId       String   @map("actor_id")
  changedFields String[] @default([]) @map("changed_fields")
  summary       String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("settings_audit_logs")
}

// -----------------------------------------------------------------------------
//  2. CLASSROOMS, SCHEDULE & ATTENDANCE
// -----------------------------------------------------------------------------

model Classroom {
  id               String           @id @default(cuid())
  code             String
  name             String
  level            String
  targetBand       String
  scheduleSummary  String
  room             String
  enrolled         Int              @default(0)
  capacity         Int              @default(15)
  attendanceRate   Float            @default(100)
  averageScore     Float            @default(7.0)
  currentModule    String
  startDate        String?
  expectedEndDate  String?
  completedAt      String?
  totalWeeks       Int              @default(12)
  currentWeekIndex Int              @default(1)
  tuitionDueDate   String?          @default("2026-11-20")
  status           ClassroomStatus  @default(active)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  students               Student[]
  sessions               ClassSession[]
  curriculumWeeks        CurriculumWeek[]
  scheduleExceptions     ScheduleException[]
  teachingJournalEntries TeachingJournalEntry[]
  attendanceRecords      AttendanceRecord[]
  gradeRecords           GradeRecord[]
  assessmentCatalogs     AssessmentCatalog[]

  @@index([code])
}

model CurriculumWeek {
  id                    String                     @id @default(cuid())
  classroomId           String
  classroom             Classroom                  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  weekNumber            Int
  title                 String
  focus                 String?
  focusSkill            String?
  notes                 String?
  status                String?                    @default("not-started")
  scheduledDate         String?
  completedDate         String?
  teacherName           String?
  plannedSessions       Int?                       @default(2)
  isAssessmentMilestone Boolean                    @default(false)
  assessmentTitle       String?
  lessonObjectives      String[]                   @default([])
  homework              String?
  homeworkDueDate       String?
  materialsCount        Int                        @default(0)
  attachments           CurriculumWeekAttachment[]

  @@unique([classroomId, weekNumber])
}

model CurriculumWeekAttachment {
  id            String         @id @default(cuid())
  attachmentKey String?        @map("attachment_key")
  weekId        String
  week          CurriculumWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  title         String
  type          String         @default("pdf")
  url           String
  storedFileId  String?        @map("stored_file_id")
  storedFile    StoredFile?    @relation(fields: [storedFileId], references: [id], onDelete: SetNull)
  sizeLabel     String?
  sizeBytes     Int?
  visibility    FileVisibility @default(public)
  uploadedAt    String
}

model CurriculumTemplate {
  id          String   @id @default(cuid())
  name        String
  level       String
  targetBand  String   @default("") @map("target_band")
  description String?
  totalWeeks  Int      @default(12)
  isCustom    Boolean  @default(true)
  weeksJson   String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClassSession {
  id            String             @id @default(cuid())
  classroomId   String?
  classroom     Classroom?         @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  classCode     String
  className     String
  level         String
  dayOfWeek     Int
  dayLabel      String
  startTime     String
  endTime       String
  room          String
  topic         String
  enrolledCount Int                @default(12)
  capacity      Int                @default(15)
  status             SessionStatus       @default(upcoming)
  hasConflict        Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attendances        AttendanceRecord[]
  scheduleExceptions ScheduleException[]

  @@index([dayOfWeek, startTime])
}

model ScheduleException {
  id                String                @id @default(cuid())
  type              ScheduleExceptionType
  originalSessionId String?               @map("original_session_id")
  originalSession   ClassSession?         @relation(fields: [originalSessionId], references: [id], onDelete: SetNull)
  classroomId       String                @map("classroom_id")
  classroom         Classroom             @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  originalDate      String                @map("original_date")
  newDate           String?               @map("new_date")
  startTime         String                @map("start_time")
  endTime           String                @map("end_time")
  room              String
  topic             String
  reason            String
  announcementId         String?                @map("announcement_id")
  createdAt              DateTime               @default(now()) @map("created_at")
  teachingJournalEntries TeachingJournalEntry[]

  @@index([classroomId, originalDate])
  @@index([newDate])
  @@map("schedule_exceptions")
}

// -----------------------------------------------------------------------------
//  3. STUDENTS, GRADES & ATTENDANCE RECORDS
// -----------------------------------------------------------------------------

model Student {
  id                  String             @id @default(cuid())
  code                String             @unique
  profileId           String?            @unique @map("profile_id") @db.Uuid
  profile             Profile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  fullName            String
  accessPinHash       String             @default("")
  classroomId         String
  classroom           Classroom          @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  className           String
  level               String
  joinedAt            String
  attendanceRate      Float              @default(100)
  averageScore        Float              @default(7.0)
  targetGoal          String
  entryBand           Float?
  tuitionStatus       TuitionStatus      @default(paid)
  tuitionPeriod       String
  tuitionAmount       String
  tuitionDueDate      String?            @default("2026-11-20")
  parentRelation      String
  parentContactMasked String
  parentName          String?
  parentPhone         String?
  parentEmail         String?
  parentNote          String?
  privateNote         String?
  leaveStartDate      String?
  leaveReturnDate     String?
  leaveReason         String?
  status              StudentStatus      @default(active)
  recentComment       String
  deletedAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  grades              GradeRecord[]
  attendanceHistory   AttendanceRecord[]
  classTransfers      ClassTransferHistory[]
  gradeChangeHistory  GradeChangeHistory[]
  tuitionPayments     TuitionPayment[]
  communicationLogs   CommunicationLog[]
  sessionEvaluations  SessionStudentEvaluation[]

  @@index([classroomId])
  @@index([tuitionStatus])
  @@index([profileId])
}

model GradeRecord {
  id              String               @id @default(cuid())
  studentId       String
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId     String?              @map("classroom_id")
  classroom       Classroom?           @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  assessmentTitle String
  date            String
  listening       Float
  reading         Float
  writing         Float
  speaking        Float
  overall         Float
  comment         String
  privateNote     String?              @map("private_note")
  status          GradePublishStatus   @default(published)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @default(now()) @updatedAt
  history         GradeChangeHistory[]

  @@index([studentId])
  @@index([assessmentTitle])
  @@index([classroomId, assessmentTitle])
  @@index([status])
}

model AssessmentCatalog {
  id          String     @id @default(cuid())
  title       String     @unique
  category    String     @default("mock-test")
  examDate    String?    @map("exam_date")
  classroomId String?    @map("classroom_id")
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([classroomId])
  @@map("assessment_catalogs")
}

model AttendanceRecord {
  id                     String                @id @default(cuid())
  studentId              String
  student                Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classroomId            String?               @map("classroom_id")
  classroom              Classroom?            @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  sessionId              String?
  session                ClassSession?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  teachingJournalEntryId String?               @map("teaching_journal_entry_id")
  teachingJournalEntry   TeachingJournalEntry? @relation(fields: [teachingJournalEntryId], references: [id], onDelete: SetNull)
  date                   String
  sessionName            String
  status                 AttendanceStatus      @default(present)
  note                   String?
  recordedBy             String?               @map("recorded_by")
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @default(now()) @updatedAt

  @@index([studentId, date])
  @@index([classroomId, date])
  @@index([teachingJournalEntryId])
}

model TuitionPayment {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  period         String
  baseAmount     Int
  discountAmount Int      @default(0)
  paidAmount     Int      @default(0)
  dueDate        String
  paidAt         String?
  method         String?
  status         String   @default("due-soon")
  note           String?
  receiptCode    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([studentId])
  @@index([status])
}

model CommunicationLog {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date             String
  channel          String   @default("zalo")
  category         String   @default("general")
  summary          String
  parentResponse   String?
  nextFollowUpDate String?
  loggedBy         String   @default("ThS. Nguyễn Minh Anh")
  createdAt        DateTime @default(now())

  @@index([studentId])
  @@index([date])
}

// -----------------------------------------------------------------------------
//  3b. AUDIT TRAIL & RATE LIMITING
// -----------------------------------------------------------------------------

model ClassTransferHistory {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  oldClassId   String
  oldClassName String    @default("") @map("old_class_name")
  newClassId   String
  newClassName String    @default("") @map("new_class_name")
  changedBy    String    @default("admin")
  changedAt    DateTime  @default(now())
  reason       String?

  @@index([studentId])
  @@index([changedAt])
}

model GradeChangeHistory {
  id              String       @id @default(cuid())
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradeRecordId   String?
  gradeRecord     GradeRecord? @relation(fields: [gradeRecordId], references: [id], onDelete: SetNull)
  assessmentTitle String
  oldScore        Float
  newScore        Float
  changedBy       String       @default("admin")
  changedAt       DateTime     @default(now())
  reason          String?

  @@index([studentId])
  @@index([gradeRecordId])
  @@index([changedAt])
}

model AuthRateLimit {
  id             String    @id @default(cuid())
  identifier     String    @unique
  failedAttempts Int       @default(1)
  firstFailedAt  DateTime  @default(now())
  lastFailedAt   DateTime  @default(now())
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([identifier])
  @@index([lockedUntil])
}

// -----------------------------------------------------------------------------
//  4. CMS: ANNOUNCEMENTS, PODCASTS, HALL OF FAME, STUDENT PROJECTS
// -----------------------------------------------------------------------------

model Announcement {
  id            String                   @id @default(cuid())
  title         String
  excerpt       String
  content       String[]
  category      AnnouncementCategory     @default(event)
  categoryLabel String
  isUrgent      Boolean                  @default(false)
  isPinned      Boolean                  @default(false)
  publishedAt   String
  readTime      String                   @default("2 phút đọc")
  targetClasses String[]
  status        ContentStatus            @default(published)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  attachments   AnnouncementAttachment[]
}

model AnnouncementAttachment {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  name           String
  size           String
  type           String       @default("PDF")
  url            String?
  objectKey      String?
  downloadCount  Int          @default(0)
}

model PodcastEpisode {
  id                   String          @id @default(cuid())
  episodeNumber        Int
  title                String
  summary              String
  showNotes            String[]
  category             PodcastCategory @default(weekly_digest)
  categoryLabel        String
  audioKey             String?
  audioUrl             String?
  thumbnailKey         String?
  durationSeconds      Int             @default(720)
  durationLabel        String
  publishedAt          String
  isFeatured           Boolean         @default(false)
  coverTheme           String          @default("navy")
  vocabularyHighlights Json
  status               ContentStatus   @default(published)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model HallOfFameEntry {
  id                 String      @id @default(cuid())
  studentId          String?
  classId            String?
  displayName        String
  avatarInitials     String
  className          String
  rank               Int         @default(1)
  period             HonorPeriod @default(month)
  periodLabel        String
  headlineMetric     String
  badgeTitle         String
  teacherEndorsement String
  milestones         String[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([period, rank])
}

model StudentProject {
  id             String        @id @default(cuid())
  title          String
  studentOrTeam  String
  className      String
  category       String
  summary        String
  keyTakeaway    String
  publishedAt    String
  externalUrl    String
  featuredMetric String
  accentTheme    String        @default("navy")
  status         ContentStatus @default(published)
  posterUrl      String?
  posterPublicId String?
  documentUrl    String?
  documentName   String?
  documentSize   String?
  videoUrl       String?
  tags           String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// -----------------------------------------------------------------------------
//  5. CLOUD RESOURCE LIBRARY & MULTI-PROVIDER STORAGE (CLOUDINARY + SUPABASE)
// -----------------------------------------------------------------------------

model ResourceFolder {
  id          String         @id @default(cuid())
  name        String
  description String
  parentId    String?
  itemCount   Int            @default(0)
  updatedAt   String
  visibility  FileVisibility @default(public)
  files       ResourceFile[]
}

model ResourceFile {
  id                 String              @id @default(cuid())
  folderId           String
  folder             ResourceFolder      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderName         String
  title              String
  description        String
  fileType           ResourceFileType    @default(PDF)
  provider           StorageProviderType @default(supabase)
  mimeType           String              @default("application/pdf")
  bucketName         String?
  storagePath        String?
  cloudinaryPublicId String?
  publicUrl          String?
  objectKey          String?
  size               String
  sizeBytes          Int                 @default(0)
  updatedAt          String
  downloads          Int                 @default(0)
  pagesOrDuration    String
  level              String
  visibility         FileVisibility      @default(public)
  category           String              @default("general")
  ownerId            String?
  originalName       String?
  storedName         String?
  previewSummary     String[]
  deletedAt          DateTime?

  @@index([folderId, visibility])
  @@index([provider, fileType])
}

model StoredFile {
  id                 String              @id @default(cuid())
  originalName       String              @map("original_name")
  storedName         String              @map("stored_name")
  provider           StorageProviderType
  fileType           String              @map("file_type")
  mimeType           String              @map("mime_type")
  fileSize           Int                 @map("file_size")
  bucketName         String?             @map("bucket_name")
  storagePath        String?             @map("storage_path")
  cloudinaryPublicId String?             @map("cloudinary_public_id")
  publicUrl          String?             @map("public_url")
  isPublic           Boolean             @default(true) @map("is_public")
  ownerId               String?                    @map("owner_id")
  category              String                     @default("general")
  referencedBy          String[]                   @default([]) @map("referenced_by")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")
  deletedAt             DateTime?                  @map("deleted_at")
  curriculumAttachments CurriculumWeekAttachment[]
  sessionAttachments    SessionAttachmentFile[]

  @@index([provider, category])
  @@index([isPublic, deletedAt])
  @@index([cloudinaryPublicId])
  @@index([bucketName, storagePath])
  @@map("stored_files")
}

// -----------------------------------------------------------------------------
//  7. TEACHING JOURNAL, REVISION LOGS & STUDENT SESSION EVALUATIONS
// -----------------------------------------------------------------------------

model TeachingJournalEntry {
  id                  String                     @id @default(cuid())
  classroomId         String                     @map("classroom_id")
  classroom           Classroom                  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  scheduleExceptionId String?                    @map("schedule_exception_id")
  scheduleException   ScheduleException?         @relation(fields: [scheduleExceptionId], references: [id], onDelete: SetNull)
  date                String
  dayLabel            String                     @map("day_label")
  startTime           String                     @map("start_time")
  endTime             String                     @map("end_time")
  room                String
  weekNumber          Int                        @default(1) @map("week_number")
  topic               String
  objectives          String                     @default("")
  completionResult    SessionCompletionResult    @default(not_completed) @map("completion_result")
  generalNotes        String                     @default("") @map("general_notes")
  privateNotes        String                     @default("") @map("private_notes")
  homework            String                     @default("")
  nextSessionPlan     String                     @default("") @map("next_session_plan")
  journalStatus       JournalStatus              @default(not_started) @map("journal_status")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")
  studentEvaluations  SessionStudentEvaluation[]
  revisions           JournalRevisionLog[]
  attachments         SessionAttachmentFile[]
  attendanceRecords   AttendanceRecord[]

  @@unique([classroomId, date, startTime])
  @@index([classroomId, date])
  @@index([journalStatus])
  @@map("teaching_journal_entries")
}

model SessionStudentEvaluation {
  id              String               @id @default(cuid())
  entryId         String               @map("entry_id")
  entry           TeachingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  studentId       String               @map("student_id")
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendance      AttendanceStatus     @default(present)
  homeworkStatus  HomeworkStatus       @default(unrecorded) @map("homework_status")
  learningStatus  LearningStatus       @default(unrecorded) @map("learning_status")
  skill           String               @default("General")
  score           Float?
  teacherFeedback String               @default("") @map("teacher_feedback")
  followUp        String               @default("") @map("follow_up")

  @@unique([entryId, studentId])
  @@index([studentId])
  @@map("session_student_evaluations")
}

model JournalRevisionLog {
  id                       String                  @id @default(cuid())
  entryId                  String                  @map("entry_id")
  entry                    TeachingJournalEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  summary                  String
  previousTopic            String                  @map("previous_topic")
  previousObjectives       String?                 @map("previous_objectives")
  previousNotes            String                  @map("previous_notes")
  previousHomework         String?                 @map("previous_homework")
  previousNextSessionPlan  String?                 @map("previous_next_session_plan")
  previousCompletionResult SessionCompletionResult @map("previous_completion_result")
  createdAt                DateTime                @default(now()) @map("created_at")

  @@index([entryId, createdAt])
  @@map("journal_revision_logs")
}

model SessionAttachmentFile {
  id           String               @id @default(cuid())
  entryId      String               @map("entry_id")
  entry        TeachingJournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  storedFileId String?              @map("stored_file_id")
  storedFile   StoredFile?          @relation(fields: [storedFileId], references: [id], onDelete: SetNull)
  name         String
  fileType     String               @default("PDF") @map("file_type")
  size         String               @default("1.0 MB")
  url          String?
  uploadedAt   DateTime             @default(now()) @map("uploaded_at")

  @@index([entryId])
  @@index([storedFileId])
  @@map("session_attachment_files")
}

model AnalyticsAlertAck {
  id        String                  @id @default(cuid())
  alertId   String                  @unique @map("alert_id")
  status    AnalyticsAlertAckStatus @default(active)
  note      String?
  updatedBy String                  @default("admin") @map("updated_by")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")

  @@index([status])
  @@map("analytics_alert_acks")
}

model StorageAuditLog {
  id         String              @id @default(cuid())
  action     String
  provider   StorageProviderType
  actorId    String              @map("actor_id")
  targetId   String              @map("target_id")
  targetPath String              @map("target_path")
  status     String
  detail     String
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([provider, action])
  @@index([createdAt])
  @@map("storage_audit_logs")
}

model OrphanedStorageFile {
  id                 String              @id @default(cuid())
  provider           StorageProviderType
  bucketName         String?             @map("bucket_name")
  storagePath        String              @map("storage_path")
  cloudinaryPublicId String?             @map("cloudinary_public_id")
  reason             String
  createdAt          DateTime            @default(now()) @map("created_at")

  @@index([provider, createdAt])
  @@map("orphaned_storage_files")
}
