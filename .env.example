# =============================================================================
#  Environment template — copy to `.env` and fill in real values.
#  Validated at runtime by src/lib/env.ts (the app fails fast on bad config).
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/english_manager?schema=public"

# --- Auth (single Teacher/Admin account) -------------------------------------
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
ADMIN_EMAIL="teacher@example.com"
# bcrypt hash of the admin password. Generate:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "your-password"
# Default demo password hash corresponds to: Admin@123
ADMIN_PASSWORD_HASH="$2b$10$50XQMNmR7QZdO8WVR1NJH.js4tt7CLFjtfUzU0kOK1REddtiEkIU6"

# --- Storage: Cloudinary Free (Images only — Server only) --------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Storage: Supabase Free Storage (Podcasts & PDFs — Server only) ----------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Storage Buckets
SUPABASE_PUBLIC_BUCKET=english-manager-public
SUPABASE_PRIVATE_BUCKET=english-manager-private

# Storage Provider Routing
STORAGE_PROVIDER_IMAGES=cloudinary
STORAGE_PROVIDER_DOCUMENTS=supabase
STORAGE_PROVIDER_AUDIO=supabase

# Upload Limits (Free-tier safe defaults)
MAX_IMAGE_SIZE_MB=5
MAX_AUDIO_SIZE_MB=40
MAX_PDF_SIZE_MB=40

# Signed URL TTL (15 minutes = 900 seconds)
PRIVATE_FILE_URL_TTL_SECONDS=900

# Quota Thresholds (%)
QUOTA_WARNING_PERCENT=70
QUOTA_CRITICAL_PERCENT=85
QUOTA_LOCK_PERCENT=95
SUPABASE_FREE_STORAGE_LIMIT_MB=1024
CLOUDINARY_FREE_STORAGE_LIMIT_MB=1024

# --- Legacy / Future S3-compatible fallback (Cloudflare R2 / AWS S3) ---------
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BUCKET="english-manager-public"
STORAGE_PRIVATE_BUCKET="english-manager-private"
STORAGE_PUBLIC_URL="https://media.example.com"

# --- App ---------------------------------------------------------------------
APP_URL="http://localhost:3000"

# --- Dev Quick-Login & Security Tests (Ignored in production) -----------------
DEV_ADMIN_EMAIL="teacher@example.com"
DEV_ADMIN_PASSWORD="YourAdminTestPassword123!"
DEV_STUDENT_EMAIL="student1@example.com"
DEV_STUDENT_PASSWORD="YourStudentTestPassword123!"
DEV_STUDENT2_EMAIL="student2@example.com"
DEV_STUDENT2_PASSWORD="YourStudentTestPassword123!"


