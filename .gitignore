


# =============================================================================
#  English Manager — Git Ignore Configuration
#  Covers Next.js 16, TypeScript, Turbopack, Prisma, Supabase, OS & Editors
# =============================================================================

# --- 1. Dependencies & Package Managers --------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- 2. Environment Variables & Credentials (CRITICAL SECURITY) -------------
# Ignore all real environment files with secrets, but KEEP .env.example
.env
.env.*
.env*.local
!.env.example

# Private keys, certificates & credentials
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
id_rsa
id_ed25519

# --- 3. Build & Output Artifacts ----------------------------------------------
/.next/
/out/
/build/
/dist/
*.tsbuildinfo
next-env.d.ts

# Turbopack cache
.turbo/

# Vercel deployment cache
.vercel

# --- 4. Testing & Code Quality ------------------------------------------------
/coverage
/.nyc_output/
/test-results/

# --- 5. Logs & Debugging ------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
logs/

# --- 6. Database & Local Storage Files ----------------------------------------
# SQLite / local embedded DBs
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal

# Generated Prisma Client (rebuilt automatically via `npx prisma generate`)
/src/generated/prisma/

# --- 7. Operating System Metadata --------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# local runtime data
/.data/

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- 8. IDEs & Editors -------------------------------------------------------
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code — ignore workspace user state, keep team recommendations if added
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
